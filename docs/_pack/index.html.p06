ml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><path d='M32 5c1.9 0 3.6 1 4.5 2.7l21.6 39.2A5.2 5.2 0 0 1 53.6 55H10.4a5.2 5.2 0 0 1-4.5-8.1L27.5 7.7A5.2 5.2 0 0 1 32 5z' fill='%232dcfb3'/><ellipse cx='25.2' cy='36.5' rx='4.1' ry='7.3' fill='%23111111'/><ellipse cx='38.8' cy='36.5' rx='4.1' ry='7.3' fill='%23111111'/></svg>");
  }
  .blob.scout {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect x='8' y='8' width='48' height='48' rx='15' fill='%236b6874'/><ellipse cx='25.5' cy='32' rx='4.1' ry='7.3' fill='%23111111'/><ellipse cx='38.5' cy='32' rx='4.1' ry='7.3' fill='%23111111'/></svg>");
  }
  .blob.player {
    border-radius: 50%;
    background-color: var(--p1);
    position: relative;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><ellipse cx='24' cy='30' rx='4.2' ry='7.4' fill='%23111111'/><ellipse cx='40' cy='30' rx='4.2' ry='7.4' fill='%23111111'/></svg>");
  }

  .agent-strip {
    display: flex; gap: 16px; overflow-x: auto; -webkit-overflow-scrolling: touch;
    padding: 14px 2px 4px; scrollbar-width: none;
  }
  .agent-strip::-webkit-scrollbar { display: none; }
  .agent-pill {
    flex: none; width: 76px; border: 0; background: transparent; padding: 0;
    cursor: pointer; display: grid; justify-items: center; gap: 6px;
    color: inherit; font: inherit; text-align: center;
  }
  .agent-pill .blob { width: 58px; height: 58px; }
  .agent-pill .an {
    font-size: 12px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.15;
    max-width: 76px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .agent-pill .ar {
    font-size: 10.5px; font-weight: 700; color: var(--muted); line-height: 1;
    max-width: 76px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  main.thread {
    flex: 1; width: 100%; max-width: 680px; margin: 0 auto;
    display: flex; flex-direction: column; gap: 18px;
    padding: 16px 14px 18px;
    padding-left: calc(14px + env(safe-area-inset-left));
    padding-right: calc(14px + env(safe-area-inset-right));
  }
  .widgets { display: contents; }
  .day-sep {
    align-self: center; color: var(--muted); font-size: 12px; font-weight: 700;
    letter-spacing: 0.02em; padding: 4px 12px; border-radius: 999px;
    background: var(--surface-2); border: 1px solid var(--hair);
  }
  .turn {
    display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 8px 10px;
    align-items: start;
  }
  .turn[hidden] { display: none; }
  .turn > .blob { margin-top: 18px; width: 40px; height: 40px; }
  .turn-body { min-width: 0; display: grid; gap: 8px; }
  .turn-who {
    display: flex; align-items: center; gap: 7px; padding-left: 4px;
    font-size: 13px; font-weight: 800; letter-spacing: -0.02em;
  }
  .turn-who .role {
    font-size: 11px; font-weight: 700; color: var(--muted);
    background: var(--surface-2); border: 1px solid var(--hair);
    border-radius: 999px; padding: 1px 8px;
  }
  .say {
    background: var(--card-solid);
    border: 1px solid var(--ring);
    border-radius: 22px 22px 22px 8px;
    padding: 12px 16px; font-size: 15px; font-weight: 600; line-height: 1.45;
    letter-spacing: -0.015em; color: var(--ink);
    box-shadow: 0 1px 1px rgba(11,10,16,0.03);
  }
  .turn .card {
    border-radius: 22px;
  }
  .composer {
    position: sticky; bottom: 0; z-index: 30;
    display: flex; align-items: center; gap: 10px;
    margin: 0 auto; width: 100%; max-width: 680px;
    padding: 10px 14px calc(12px + env(safe-area-inset-bottom));
    padding-left: calc(14px + env(safe-area-inset-left));
    padding-right: calc(14px + env(safe-area-inset-right));
    text-decoration: none; color: inherit;
    background: color-mix(in srgb, var(--aura-base) 88%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    backdrop-filter: blur(18px) saturate(140%);
    border-top: 1px solid var(--hair);
  }
  .composer-plus {
    flex: none; width: 36px; height: 36px; border-radius: 12px;
    display: grid; place-items: center; font-size: 22px; font-weight: 500;
    color: var(--ink-2); background: var(--surface-2); border: 1px solid var(--hair);
    line-height: 1;
  }
  .composer-field {
    flex: 1; min-width: 0; height: 44px; border-radius: 22px;
    display: flex; align-items: center; padding: 0 16px;
    background: var(--card-solid); border: 1px solid var(--ring);
    color: var(--muted); font-size: 15px; font-weight: 600;
  }
  .composer-mic {
    flex: none; width: 36px; height: 36px; border-radius: 999px;
    background: var(--ink); color: var(--aura-base);
    display: grid; place-items: center;
  }
  .composer-mic svg { display: block; }
  footer {
    max-width: 680px; margin: 4px auto 16px; padding:
      0 calc(14px + env(safe-area-inset-right))
      calc(8px + env(safe-area-inset-bottom))
      calc(14px + env(safe-area-inset-left));
  }

</style>
</head>
<body>
<div class="chat-app">
  <header class="chat-head">
    <div class="head-row">
      <div class="head-id">
        <span class="blob warren sm" aria-hidden="true"></span>
        <div class="head-copy">
          <h1 data-i18n="agentWarren">Warren</h1>
          <p class="head-sub"><span class="role" data-i18n="agentWarrenRole">Trader</span><span class="dotsep">·</span><span data-i18n="appTitle">Trader League</span></p>
        </div>
      </div>
      <div class="hbtns">
        <div class="langwrap">
          <button class="lang" id="lang-btn" type="button" aria-haspopup="true"
                  aria-expanded="false" aria-controls="lang-menu"><span id="lang-label"></span></button>
          <div class="langmenu" id="lang-menu" role="menu" hidden></div>
        </div>
      </div>
    </div>
    <div class="agent-strip" id="agent-strip" role="list"></div>
    <div class="hbar">
      <span class="chip" id="hchip"><span data-i18n="allPlayers"></span> <span class="caret">▾</span></span>
      <span class="period" data-i18n="periodAll"></span>
    </div>
    <div class="eyebrow" id="eyebrow"></div>
  </header>

  <main class="thread">
    <div class="day-sep" id="day-sep"></div>

    <article class="turn" data-agent="warren" data-watch="pending-card">
      <span class="blob warren" aria-hidden="true"></span>
      <div class="turn-body">
        <div class="turn-who"><strong data-i18n="agentWarren"></strong><span class="role" data-i18n="agentWarrenRole"></span></div>
        <p class="say" id="say-pending"></p>
<section class="card warn" id="pending-card" style="display:none">
    <h2 data-i18n="pendingTitle"></h2>
    <div class="wsub" id="pending" style="margin-top:6px"></div>
  </section>
      </div>
    </article>

    <div id="widgets" class="widgets">
    <article class="turn" data-agent="warren">
      <span class="blob warren" aria-hidden="true"></span>
      <div class="turn-body">
        <div class="turn-who"><strong data-i18n="agentWarren"></strong><span class="role" data-i18n="agentWarrenRole"></span></div>
        <p class="say" id="say-standings"></p>
<section class="card" id="hero-card">
      <a class="gpban ca-banner" id="ca-banner" target="_blank" rel="noopener noreferrer"
         data-i18n-aria="caAria">
        <span class="cicon" aria-hidden="true">🍁</span>
        <span class="ctext">
          <span class="ckicker" data-i18n="caTitle"></span>
          <span class="cmain" data-i18n="gpTitle"></span>
          <span class="csub" data-i18n="caSub"></span>
        </span>
        <span class="carrow" aria-hidden="true">→</span>
      </a>
      <!-- quién va ganando el Gran Premio: el líder de la general con su
           acumulado y la ventaja sobre el segundo, y el resto del podio. -->
      <div class="gp" id="gp">
        <div class="gp-lead" id="gp-lead">
          <span class="gp-flag" aria-hidden="true">🏁</span>
          <div class="gp-l">
            <div class="gp-kicker" data-i18n="gpLeading"></div>
            <div cl