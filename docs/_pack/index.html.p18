      worstDrop: (a, p) => a + "が当日最大の下げ：" + p + "。",
      allRed: () => "忘れたい一日。リーグ全員が今日マイナスで終了。",
      allGreen: () => "追い風。リーグ全員が今日プラスで終了。",
